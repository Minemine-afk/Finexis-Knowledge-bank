POSTGRES_PASSWORD=change-me-admin
KB_APP_PASSWORD=change-me-app

# Optional local language model for chat answers. Leave LLM_MODEL empty to show passages only.
# With the bundled Ollama:  docker compose --profile llm up -d
#                           docker compose exec ollama ollama pull qwen2.5:7b-instruct
LLM_API=ollama
LLM_URL=http://ollama:11434
LLM_MODEL=

# Where original files are kept: local (default) | supabase | s3 (AWS S3, Cloudflare R2)
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=documents
# S3_BUCKET=documents
# S3_ENDPOINT_URL=          # R2: https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION=auto

# Cloud model instead of Ollama (sends passages to the provider):
# LLM_API=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Required on any hosted copy while login is the prototype user picker:
# SITE_PASSWORD=
